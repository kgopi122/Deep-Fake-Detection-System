# Environment Variables Template for Veritrue Project

# Database Configuration
MONGO_URI=mongodb://mongodb:27017/Deep_Fake

# Service Communication URLs
FASTAPI_URL=http://fastapi-service:8001

# Application Container Ports
SPRING_PORT=8000
FASTAPI_PORT=8001
FRONTEND_PORT=3000

# Hugging Face Access Token (Optional, for private/rate-limited models)
HF_TOKEN=your_huggingface_token_here
